# Backend configuration
STRIPE_SECRET_KEY=sk_test_...
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
PORT=5000

# Aurora/Vercel exposes one of these; the server maps it to DATABASE_URL.
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Firebase Admin: use either the JSON string or the three fields.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
